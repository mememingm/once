DATABASE_URL=postgresql://once:replace-with-a-local-password@127.0.0.1:55432/once?schema=public
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
NODE_ENV=development
DEMO_MODE=true

# ONCE operator (B-end) PC hosting account, shared by all ONCE C-end users.
# Keep the API Key on the server. C-end users never need PC accounts or keys.
# Leave empty to disable real SMS sending.
# Base URL includes the PC deployment prefix and /api/open/v1.
# Account ID must match GET /me; scopes: numbers:read, sms:read, sms:send.
PINGCODE_BASE_URL=
PINGCODE_ACCOUNT_ID=
PINGCODE_API_KEY=
# Optional project-receipt compatibility only; ordinary /sms/send uses result polling.
PINGCODE_SEND_WEBHOOK_SECRET=
# Required for incoming SMS: public HTTPS /api/webhooks/pingcode/receive
PINGCODE_RECEIVE_WEBHOOK_SECRET=
